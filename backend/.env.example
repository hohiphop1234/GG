# HuggingFace Token (Tùy chọn: giúp tránh giới hạn rate limit khi tải model embedding)
HF_TOKEN=your_huggingface_token_here

# Đặt true nếu muốn chạy chế độ test nhanh bằng hash embedding thay vì model thật
FORCE_FALLBACK_EMBEDDINGS=false

# API Key cho Tavily Web Search (Cào thông tin y khoa bổ sung từ internet)
TAVILY_API_KEY=your_tavily_api_key_here

# Đường dẫn tới thư mục chứa file thực thi llama-server.exe (Tùy chọn)
# LLAMA_SERVER_PATH=E:\Github\Intelligent-Medical-Assistant-for-Healthcare-Consultation\backend\llama-b9850-bin-win-vulkan-x64\llama-server.exe

